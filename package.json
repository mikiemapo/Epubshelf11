{
  "name": "bookshelf-elevenreader",
  "version": "1.0.0",
  "description": "Offline-first EPUB, Complex Table & AI Voice Reader (Thorium-style Electron App)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.personal.bookshelf.elevenreader",
    "productName": "Bookshelf Reader",
    "files": ["app/**/*", "electron/**/*"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
